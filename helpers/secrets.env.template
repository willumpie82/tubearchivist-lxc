# TubeArchivist Helper Secrets Template
# Copy to /etc/ta-helper/secrets.env and fill in your values:
# 
# sudo cp helpers/secrets.env.template /etc/ta-helper/secrets.env
# sudo chmod 600 /etc/ta-helper/secrets.env
# sudo nano /etc/ta-helper/secrets.env

# TubeArchivist API credentials
# Use your TA admin username and password
TA_USERNAME=admin
TA_PASSWORD=changeme

# Jellyfin API settings
# Get your API key from Jellyfin: Settings > Dashboard > API Keys
JF_API_URL=http://localhost:8081
JF_API_KEY=your_jellyfin_api_key_here
